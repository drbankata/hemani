# Allowlist: ignore everything, then publish only the site's own files.
# The repo is PUBLIC. To publish a new file or folder, add a "!/name" line here on purpose.
/*
!/.gitignore
!/.nojekyll
!/README.md
!/index.html
!/404.html
!/robots.txt
!/sitemap.xml
!/assets/
!/about/
!/choose-your-blueprint/
!/contact-us/

# Custom domain (live since 2026-10-05): www.quantumsuccessblueprint.com
!/CNAME

# Never publish, even inside allowed folders
**/NOTES.md
**/.env*
**/*.psd
**/*.ai
**/Thumbs.db
**/.DS_Store
